# Neon: Dashboard > your project > Connect > copy the connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Telegram: token from @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string. Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Who may use the bot and dashboard: Telegram user IDs (from @userinfobot), comma-separated.
# Each person gets their own private accounts, categories and transactions.
# The FIRST ID is the owner: they inherit data from before multi-user and can edit the shared USD rate.
# Use * to let anyone in (AI calls then run on your key).
ALLOWED_TELEGRAM_USER_IDS=

# AI for categories (optional; keyword matching is used without it).
# Free key: https://aistudio.google.com/apikey
AI_API_KEY=
# Defaults to Gemini. Any OpenAI-compatible API works.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash-lite

# Signs dashboard login cookies. Any random string of 16+ characters: openssl rand -hex 32
# Changing it logs everyone out. Each user's dashboard password is set in the bot with /password.
SESSION_SECRET=

# Optional: secures the daily cron (recurring transactions, reports, month-end reminder). Vercel sends it automatically when set.
# CRON_SECRET=
