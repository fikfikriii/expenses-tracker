# Neon: Dashboard > your project > Connect > copy the connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Telegram: token from @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string. Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Your Telegram user ID (from @userinfobot). Comma-separate to allow more people.
ALLOWED_TELEGRAM_USER_IDS=

# AI for categories (optional; keyword matching is used without it).
# Free key: https://aistudio.google.com/apikey
AI_API_KEY=
# Defaults to Gemini. Any OpenAI-compatible API works.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash-lite
